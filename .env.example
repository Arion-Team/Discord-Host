# DiscordHost Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Session
SESSION_SECRET=change-this-to-a-random-secret-string-min-32-chars

# Database
DATABASE_PATH=./data/discordhost.db

# File Upload
MAX_UPLOAD_SIZE=52428800

# Bots Storage
BOTS_STORAGE_PATH=./bots
DEFAULT_BOT_STORAGE_MB=512

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Discord Bot (for verification & management commands)
DISCORD_BOT_TOKEN=your-discord-bot-token-here
PANEL_URL=http://localhost:3000
